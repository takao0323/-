# LINE Messaging API設定
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# リッチメニュー画像URL（アップロード後に設定）
RICH_MENU_IMAGE_URL=https://example.com/rich_menu_image.png

# グループLINE招待URL
GROUP_LINE_INVITE_URL=https://line.me/R/ti/g/xxxxxxxxxxxxx

# その他設定
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# コラム配信時刻（24時間形式）
COLUMN_DELIVERY_HOUR=8
COLUMN_DELIVERY_MINUTE=0
